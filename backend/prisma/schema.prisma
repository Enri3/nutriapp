generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int           @id @default(autoincrement())
  nombre          String
  apellido        String
  email           String        @unique
  password        String
  fechaNacimiento DateTime?
  peso            Float?
  altura          Float?
  nivelActividad  String?
  fechaCreacion   DateTime      @default(now())
  planesSemanales PlanSemanal[]
  recetas         Receta[]

  @@map("usuarios")
}

model CategoriaReceta {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  imagenUrl   String?
  recetas     Receta[]

  @@map("categorias_receta")
}

model Receta {
  id                 Int             @id @default(autoincrement())
  usuarioId          Int
  nombre             String
  descripcion        String?
  categoriaRecetaId  Int
  tiempoPreparacion  Int
  cantidadPorciones  Int
  dificultad         String
  imagenUrl          String?
  estado             String
  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt
  comidas            Comida[]
  categoriaReceta    CategoriaReceta @relation(fields: [categoriaRecetaId], references: [id])
  usuario            Usuario         @relation(fields: [usuarioId], references: [id])

  @@map("recetas")
}

model PlanSemanal {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  nombre        String
  fechaInicio   DateTime
  fechaFin      DateTime
  fechaCreacion DateTime @default(now())
  comidas       Comida[]
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("planes_semanales")
}

model Comida {
  id            Int         @id @default(autoincrement())
  planSemanalId Int
  recetaId      Int
  tipoComida    String
  porcionReceta Float
  fecha         DateTime
  planSemanal   PlanSemanal @relation(fields: [planSemanalId], references: [id])
  receta        Receta      @relation(fields: [recetaId], references: [id])

  @@map("comidas")
}